{
  "name": "popup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "setup": "bash ./setup.sh",
    "install:all": "npm install && (pip3 install -r requirements.txt 2>/dev/null || pip3 install -r requirements.txt --break-system-packages)",
    "install:py": "pip3 install -r requirements.txt 2>/dev/null || pip3 install -r requirements.txt --break-system-packages",
    "desktop": "python3 desktop_overlay.py",
    "desktop:high": "./run_high.sh",
    "desktop:low": "./run_low.sh",
    "desktop:chrome": "google-chrome --app=http://127.0.0.1:5173 --window-size=1920,1080",
    "tauri": "tauri"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
